# Copy to .env for local setup. Keep real credentials in your private .env only.
NODE_ENV=development
EMAIL_DRAFT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MONGO_URI=mongodb://127.0.0.1:27017/freelancereach
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated allowed browser origins; set the frontend Vercel URL in production.
CLIENT_URL=http://localhost:5173
PORT=5000
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production callback: https://<backend-domain>/api/gmail/oauth/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/api/gmail/oauth/callback
# Generate 32 random bytes and encode as 64 hexadecimal characters. Keep stable to decrypt stored tokens.
GMAIL_TOKEN_ENCRYPTION_KEY=
